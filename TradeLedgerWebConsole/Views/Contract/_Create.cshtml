@model TradeLedgerWebConsole.Domain.Contract

<div class="modal fade" id="modal-contract" tabindex="-1" aria-labelledby="brokerModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="brokerModalLabel">Edit Contract</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="brokerModalLabel">Add Contract</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                @if (ViewBag.ShowCompany)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label> Company <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control" })
                            <span class="text-danger"></span>
                        </div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col">
                        <label>Seller Client <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SellerClientId, ViewBag.Sellers as List<SelectListItem>, "Select Seller Client", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Seller Broker <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SellerBrokerId, ViewBag.Brokers as List<SelectListItem>, "Select Seller Broker", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Buyer Client <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BuyerClientId, ViewBag.Buyers as List<SelectListItem>, "Select Buyer Client", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Buyer Broker <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BuyerBrokerId, ViewBag.Brokers as List<SelectListItem>, "Select Buyer Broker", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>

                <!-- Items -->
                <div class="row mb-2">
                    <div class="col">
                        <div class="d-flex justify-content-between align-items-center">
                            <label>Items</label>
                            <button type="button" class="btn btn-outline-primary" id="add-item">Add Item</button>
                        </div>
                        <hr />
                        <div id="item-container">
                            @for (int i = 0; i < Model.ContractItems.Count; i++)
                            {
                                @Html.Partial("_CreateContractItem", Model.ContractItems[i], new ViewDataDictionary(ViewData) { { "ItemIndex", i } })
                            }
                        </div>
                        <span class="text-danger" id="ItemError"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>
<script src="@Url.Content("~/custom-js/contract/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)

