@model List<TradeLedgerWebConsole.Domain.ContractItem>

<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    Item
                </th>
                <th>
                    Quantity
                </th>
                <th>
                    Rate
                </th>
                <th>
                    Seller Brokerage
                </th>
                <th>
                    Buyer Brokerage
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model != null && Model.Count > default(int))
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.ItemId
                        </td>
                        <td>
                            @item.Qty
                        </td>
                        <td>
                            @item.Rate
                        </td>
                        <td>
                            @item.SellerBrokerage
                        </td>
                        <td>
                            @item.BuyerBrokerage
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="5">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>