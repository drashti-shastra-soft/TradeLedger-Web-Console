@model TradeLedgerWebConsole.Domain.Client

<div class="modal fade" id="modal-client" tabindex="-1" aria-labelledby="clientModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="clientModalLabel">Edit Client</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="clientModalLabel">Add Client</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                @if (ViewBag.ShowCompany)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label> Company </label>
                            @Html.DropDownListFor(m => m.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control" })
                        </div>
                    </div>
                }

                <div class="row mb-2">
                    <div class="col">
                        <label>Client Type <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.ClientTypeId, ViewBag.ClientTypes as List<SelectListItem>, "Select Client Type", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-6">
                        <label>Contact Person <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.ContactPerson, new { @class = "form-control", placeholder = "Enter Contact Person" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Brand</label>
                        @Html.TextBoxFor(m => m.Brand, new { @class = "form-control", placeholder = "Enter Brand" })
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Mobile Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control", placeholder = "Enter Mobile Number" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Email Address <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Enter Email Address" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>PAN Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.PanNumber, new { @class = "form-control", placeholder = "Enter PAN Number" })
                        <span class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label>GST Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.GSTNumber, new { @class = "form-control", placeholder = "Enter GST Number" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary" data-form="frmCreate">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/client/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)